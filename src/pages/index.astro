---
import SiteLayout from "../layouts/SiteLayout.astro";
import Ocean from "../components/Ocean.astro";
import Entrance from "../components/Entrance.astro";
import Hero from "../components/Hero.astro";
import Concept from "../components/Concept.astro";
import Tracklist from "../components/Tracklist.astro";
import EventInfo from "../components/EventInfo.astro";
import Credits from "../components/Credits.astro";
import AudioControl from "../components/AudioControl.astro";
import { album } from "../config/album";
---

<SiteLayout>
	<Ocean />
	<Entrance />

	<main>
		<Hero />
		<Concept />
		<Tracklist />
		<EventInfo />
		<Credits />
		<footer>{album.artist} — {album.event}</footer>
	</main>

	<AudioControl />

	<script>
		import { initEntrance } from "../scripts/entrance-controller";
		initEntrance();
	</script>
</SiteLayout>
