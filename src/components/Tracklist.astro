---
import { album } from "../config/album";
---

<section id="tracklist">
	<h2>Tracklist</h2>
	<ol class="tracklist">
		{
			album.tracks.map((title, i) => (
				<li>
					<span class="tracklist__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
					<span>{title}</span>
				</li>
			))
		}
	</ol>
</section>
