---
/** The single persistent scene: sunset sky, horizon, sea, wind, grain. */
---

<div class="ocean" aria-hidden="true">
	<div class="ocean__sky"></div>
	<div class="ocean__sea"></div>
	<div class="ocean__horizon"></div>
	<div class="ocean__shimmer"></div>
	<div class="ocean__wind"></div>
	<div class="ocean__wind ocean__wind--b"></div>
	<div class="ocean__grain"></div>
</div>
<div class="scrim" aria-hidden="true"></div>
