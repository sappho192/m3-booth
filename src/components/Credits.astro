---
import { album } from "../config/album";
---

<section id="credits">
	<h2>Credits</h2>
	<ul class="info-list">
		{
			album.credits.map((credit) => (
				<li>
					<span class="label">{credit.role}</span>
					<span>{credit.name}</span>
				</li>
			))
		}
	</ul>
</section>

{
	album.links.length > 0 && (
		<section id="links">
			<h2>Links</h2>
			<ul class="links-list">
				{album.links.map((link) => (
					<li>
						<a href={link.url} target="_blank" rel="noopener noreferrer">
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}
